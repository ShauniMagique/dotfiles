{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/ascii.txt",
        "padding": {
            "top": 2,
            "right": 6,
        },
	"color": {
        "1": "34"
    }
    },
    "display": {
        "separator": " •  "
    },
    "modules": [
	"break",
	"break",
	{
            "type": "title",
            "color": {
                "user": "33",  // = color2
                "at": "37",
                "host": "33"
            }
        },
        "break",
        {
            "type": "os",
            "key": "distribution   ",
            "keyColor": "34",
        },
        {
            "type": "kernel",
            "key": "linux kernel   ",
            "keyColor": "34",
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": "packages       ",
            "keyColor": "34",  
        },
        {
            "type": "shell",
            "key": "unix shell     ",
            "keyColor": "34", 
        },
        {
            "type": "terminal",
            "key": "terminal       ",
            "keyColor": "34", 
        },
        {
            "type": "wm",
            "format": "{} ({3})",
            "key": "window manager ",
            "keyColor": "34", 
        },
	{
	    "type": "media",
	    "key": "now playing    ",
	    "keyColor": "34",
	},
        "break",
        {
            "type": "colors",
            "symbol": "circle",
        },
        "break",
        "break",
    ]
}
